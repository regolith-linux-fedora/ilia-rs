# The Vala unit tests retired with the Vala sources; their vectors live on
# as the crate's own unit tests. Smoke-test the built binary instead.
test('version', ilia_bin, args: ['-v'])
# The calculator page's helper on the expressions the page writes for it,
# including parts with no value that the rest of an expression would cancel.
test('calculator-helper', find_program('calculator-helper.sh'),
    args: [calculator_helper])
